{
  "version": 1,
  "hooks": {
    "workspaceOpen": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/update-skills.ps1",
        "timeout": 15
      }
    ],
    "sessionStart": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/update-skills.ps1",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/update-skills.ps1",
        "timeout": 15
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/track-skill-usage.ps1",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/track-skill-usage.ps1",
        "timeout": 10,
        "matcher": "Read"
      }
    ]
  }
}
